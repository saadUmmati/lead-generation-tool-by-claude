# Copy to .env and fill in. Never commit .env.
#
# Which AI writes the pitches:  auto | gemini | groq
#   auto (default) = use every provider that has a key; if one fails (503, rate/daily
#   limit) the same pitch is automatically retried on the other one.
LLM_PROVIDER=auto

# --- Google Gemini (free key: https://aistudio.google.com/app/apikey) ---
GEMINI_API_KEY=
# Optional. Leave empty to auto-pick the newest Flash model your key can use.
GEMINI_MODEL=
# Seconds between Gemini requests. Raise it if you see rate-limit messages.
GEMINI_MIN_INTERVAL_SECONDS=6

# --- Groq (free key, no card: https://console.groq.com/keys) ---
GROQ_API_KEY=
# Optional. One model or a comma-separated list tried in order. Default:
# openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=
# Groq's free tier has a small tokens-per-minute budget, so we pace gently.
GROQ_MIN_INTERVAL_SECONDS=8
